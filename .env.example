# Copy to `.env` and fill in real values. `.env` is gitignored — never commit real credentials.

# MongoDB (docker-compose service name "mongo" by default)
MONGO_URI=mongodb://mongo:27017

# Kafka (docker-compose service name "kafka" by default)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# API
API_LOG_LEVEL=info

# mongo-express — dev-only Mongo web UI at http://127.0.0.1:8081 (login below)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=change-me
